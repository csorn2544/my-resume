  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.33.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vue-eslint-parser": "^9.4.3",
